<form id="edit-form">
<div id="request-input">
  {{#if description}}
    <div class="alert alert-secondary" style="padding: 10px; margin-bottom: 10px;">{{description}}</div>
  {{/if}}
  <table class="fixed" width="100%">
  <tr>
    <th>{{t "fieldName"}}</th>
    <th>{{t "type"}}</th>
    <th width="50%">{{t "value"}}</th>
  </tr>
  {{#if typeField}}
    {{#with typeField}}
      <tr>
        <td>
          {{#if required}}<span class="required">*</span>{{/if}}
          {{name}}:
        </td>
        <td>
          <span class="inactive">{{t "schemaName"}}</span>
        </td>
        <td>
          {{>field.hbs}}
        </td>
      </tr>
    {{/with}}
  {{/if}}
  {{#if hasFields}}
    {{#each fields}}
      <tr>
        <td>
          {{#if required}}<span class="required">*</span>{{/if}}
          {{name}}
          {{#if description}}
            <span class="tip" title="{{description}}"><i class="bi bi-info-circle"></i></span>
          {{/if}}
        </td>
        <td>
          <span class="inactive">{{{displayType}}}</span>
        </td>
        <td>
          {{#if writable}}
            {{>field.hbs}}
          {{else}}
            <span class="inactive">
              {{#if value}}
                {{value}}
              {{else}}
                &ndash;
              {{/if}}
          {{/if}}
        </td>
      </tr>
    {{/each}}
  {{else}}
    <tr>
      <td colspan="3" style="text-align: center;">
        <br/>
        {{#ifEqual mode "action"}}
          <i>{{t "noActionInputs"}}</i>
        {{else}}
          {{#ifEqual mode "update"}}
            <i>{{t "noEditableFields"}}</i>
          {{else}}
            <i>{{t "noSettableFields"}}</i>
          {{/ifEqual}}
        {{/ifEqual}}
      </td>
    </tr>
  {{/if}}
  </table>
</div>

<div id="request-output">
</div>
</form>
