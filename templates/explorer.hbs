<div id="header">
  <table id="header-body" width="100%">
  <tr>
  <!--
    <td>
      <form>
        <label class="checkbox"><input type="checkbox" id="show_removed"/>Show removed resources</label><br/>
      </form>
    </td>
  -->
    <td style="vertical-align: top; text-align: right">
      <label for="pasturestack-locale">{{t "language"}}</label>
      <select id="pasturestack-locale" class="pasturestack-locale" onchange="PastureStackI18n.setLocale(this.value)">
        <option value="en-US">English</option>
        <option value="zh-TW">繁體中文</option>
      </select><br/>
      <a href="#" onclick="htmlapi.logout(); return false">{{t "logOut"}}</a><br/>

      <a href="#" onclick="Cookie.set('apiview','browse'); htmlapi.show(); return false">{{t "jsonView"}}</a><br/>
      {{#if docs}}
        <a href="{{docs}}" target="pasturestack-api-docs">{{t "documentation"}}</a>
      {{/if}}
    </td>
  </tr>
  </table>
</div>

<div id="explorer">
  <div id="explorer-wrapper">
  </div>
</div>
