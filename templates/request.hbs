<b>{{t "curlCommand"}}:</b>
<br/>
<div id="curl" class="well">
  curl 
    {{#if curl_user}}-u <i>"{{curl_user}}"</i> \<br/>{{/if}}
    -X {{method}} \<br/>
    -H 'Accept: application/json'  \<br/>
    {{#if rawBody}}
      {{#eachProperty rawBody}}
        {{#if value.blob}}
          -F {{key}}="@{{value.value}}" \<br/>
        {{else}}
          -F {{key}}="{{value.value}}" \<br/>
        {{/if}}
      {{/eachProperty}}
    {{else}}
      {{#if contentType}}
        -H 'Content-Type: {{contentType}}' \<br/>
      {{/if}}
      {{#if body}}
        -d '{{body}}' \<br/>
      {{/if}}
    {{/if}}
    '{{baseUrl}}{{path}}'
</div>

<b>{{t "httpRequest"}}:</b><br/>
<div id="request" class="well">
  HTTP/1.1 {{method}} {{path}}<br/>
  Host: {{host}}<br/>
  Accept: application/json<br/>

  {{#if contentType}}
    Content-Type: {{contentType}}<br/>
  {{/if}}

  {{#if rawBody}}
    Content-Length: <i>unknown</i><br/>
  {{else}}
    {{#if contentLength}}
      Content-Length: {{contentLength}}<br/>
    {{/if}}
  {{/if}}

  <br/>
  {{#if rawBody}}
    {{#eachProperty rawBody}}
      --{{boundary}}<br/>
      {{#if value.blob}}
        Content-Disposition: form-data; name="{{key}}"; filename="{{value.value}}"<br/><br/>
        Content-Type: application/octet-stream<br/><br/>
        <i>(binary data)</i><br/>
      {{else}}
        Content-Disposition: form-data; name="{{key}}"<br/><br/>
        {{value.value}}<br/>
      {{/if}}
    {{/eachProperty}}
    --{{boundary}}--
  {{else}}
    {{#if prettyBody}}
      <div class="json">{{{prettyBody}}}</div>
    {{/if}}
  {{/if}}
</div>

<b>{{t "httpResponse"}}:</b><br/>
<div id="response" class="well">
  <div id="notsent" class="inactive" style="padding: 20px; text-align: center;">{{t "clickToSend"}}</div>
  <div id="waiting" class="inactive" style="padding: 20px; text-align: center; display: none;">{{t "waiting"}}</div>
  <div id="result" style="display: none;"></div>
</div>
