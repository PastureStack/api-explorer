<div id="filter-body">
</div>
<div id="no-filters" class="inactive" {{#if hasFilters}}style="display: none;"{{/if}}>{{t "none"}}</div>
{{#if canFilter}}
  <div class="filter-controls">
    <button type="button" class="btn btn-primary btn-sm" onclick="htmlapi.filterClear();"><span class="glyphicon glyphicon-ban-circle"></span> {{t "clear"}}</button>
    <button type="button" class="btn btn-primary btn-sm" onclick="htmlapi.filterAdd();"><span class="glyphicon glyphicon-plus-sign"></span> {{t "add"}}</button>
    <button type="submit" class="btn btn-primary btn-sm"><span class="glyphicon glyphicon-filter"></span> {{t "apply"}}</button>
  </div>
{{/if}}
