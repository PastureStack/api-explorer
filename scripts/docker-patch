#!/bin/bash

# Use this script to patch API Explorer in an explicitly selected test container.

CONTAINER=${1:-}
TARGET_PATH=${PASTURESTACK_API_EXPLORER_PATH:-/usr/share/pasturestack/ui/api-explorer}

if [ -z "$1" ]; then
  echo "Need container ID"
  exit 1
fi

if [ ! -d ./dist ]; then
  echo "You need to build first with 'yarn build'"
  exit 1
fi

echo "Patching test container with the local PastureStack API Explorer build"

docker exec -it "${CONTAINER}" sh -c "test -d '${TARGET_PATH}' && rm -rf '${TARGET_PATH:?}'/*"

# Copy in the built code

VERSION=$(node -e "(function () { console.log(require('./package.json').version) })()")

docker cp "./dist/${VERSION}/." "${CONTAINER}:${TARGET_PATH}/"
