#!/usr/bin/env bash
set -euo pipefail

umask 022
export LC_ALL=C

echo "Building PastureStack API Explorer"

rm -rf ./dist ./tmp

mkdir -p tmp/tpl tmp/source/templates tmp/source/partials

VERSION=$(npm pkg get version | tr -d '"')
SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH:-$(git -c safe.directory="$PWD" show -s --format=%ct HEAD)}
case "$SOURCE_DATE_EPOCH" in
  ''|*[!0-9]*)
    echo "SOURCE_DATE_EPOCH must be an integer" >&2
    exit 1
    ;;
esac
echo "Version: ${VERSION}"
echo ""

echo "Installing NPM dependencies"
if [ -f package-lock.json ]; then
  npm ci --ignore-scripts --omit=optional --no-audit --no-fund
else
  npm install --ignore-scripts --omit=optional --no-audit --no-fund
fi

HB_EXEC=./node_modules/.bin/handlebars

DIST=./dist/${VERSION}
mkdir -p ${DIST}

echo "Compiling templates ..."

# Compile templates
while IFS= read -r -d '' FILE; do
  NAME=$(basename "$FILE")
  NORMALIZED="./tmp/source/templates/${NAME}"
  sed 's/\r$//' "$FILE" > "$NORMALIZED"
  "${HB_EXEC}" "$NORMALIZED" -f "./tmp/tpl/${NAME}.js"
done < <(find ./templates -maxdepth 1 -type f -print0 | sort -z)

# Compile partials
while IFS= read -r -d '' FILE; do
  NAME=$(basename "$FILE")
  NORMALIZED="./tmp/source/partials/${NAME}"
  sed 's/\r$//' "$FILE" > "$NORMALIZED"
  "${HB_EXEC}" --partial "$NORMALIZED" -f "./tmp/tpl/${NAME}.js"
done < <(find ./partials -maxdepth 1 -type f -print0 | sort -z)

echo "Building ..."

JS_FILES=(node_modules/jquery/dist/jquery.js \
  vendor/jquery.scrollintoview.js \
  vendor/async.js \
  vendor/json2.js \
  vendor/polyfill.js \
  vendor/JSONFormatter.js \
  src/URLParse.js \
  src/Cookie.js \
  node_modules/handlebars/dist/handlebars.runtime.js \
  src/i18n.js \
  src/template.js)
while IFS= read -r -d '' FILE; do
  JS_FILES+=("$FILE")
done < <(find ./tmp/tpl -maxdepth 1 -type f -name '*.js' -print0 | sort -z)
JS_FILES+=(\
  src/ui-compat.js \
  src/HTMLApi.js \
  src/Explorer.js \
  src/init.js)

# Combine all javascript files together
# Need to add a semicolon between each file
for str in "${JS_FILES[@]}"; do
  cat "$str" >> "${DIST}/ui.js"
  echo ";" >> "${DIST}/ui.js"
done

# Preserve the reviewed static layout assets without shipping Bootstrap's
# executable plug-ins.  The CSS font path is made relative to the emitted
# stylesheet so the local fixture and the Server's versioned route agree.
mkdir -p \
  "${DIST}/fonts" \
  "${DIST}/licenses/bootstrap-3.4.1" \
  "${DIST}/licenses/jquery-3.7.1" \
  "${DIST}/licenses/handlebars-4.7.9" \
  "${DIST}/licenses/inherited-vendor"
cp vendor/bootstrap-3.4.1/fonts/* "${DIST}/fonts/"
cp LICENSE.txt ORIGIN.md THIRD-PARTY-NOTICES.md "${DIST}/licenses/"
cp vendor/bootstrap-3.4.1/LICENSE \
  vendor/bootstrap-3.4.1/NORMALIZE-LICENSE \
  vendor/bootstrap-3.4.1/NOTICE.md \
  vendor/bootstrap-3.4.1/SHA256SUMS \
  "${DIST}/licenses/bootstrap-3.4.1/"
cp node_modules/jquery/LICENSE.txt "${DIST}/licenses/jquery-3.7.1/LICENSE.txt"
cp node_modules/handlebars/LICENSE "${DIST}/licenses/handlebars-4.7.9/LICENSE"
cp vendor/licenses/LICENSE-* vendor/licenses/NOTICE-* \
  "${DIST}/licenses/inherited-vendor/"
find "${DIST}/licenses" -type f -exec sed -i 's/\r$//' {} +

# Generate css
sed 's@url("../fonts/@url("./fonts/@g' \
  vendor/bootstrap-3.4.1/css/bootstrap.css > ./tmp/layout.css
cat ./tmp/layout.css \
  styles/main.scss \
  styles/explorer.scss \
  > ./tmp/ui.scss

# Compile sass
./node_modules/.bin/sass ./tmp/ui.scss ${DIST}/ui.css

# Minimise javascript
./node_modules/.bin/uglifyjs -c -o "${DIST}/ui.min.js" "${DIST}/ui.js"

# Minimise css
node - "${DIST}/ui.css" "${DIST}/ui.min.css" <<'NODE'
const fs = require('fs');
const CleanCSS = require('clean-css');
const input = fs.readFileSync(process.argv[2], 'utf8');
const output = new CleanCSS({level: 2}).minify(input);
if (output.errors.length) {
  throw new Error(output.errors.join('\n'));
}
fs.writeFileSync(process.argv[3], output.styles);
NODE

# Do not ship source maps or dangling source-map references.
find "${DIST}" -type f -name '*.map' -delete
find "${DIST}" -type f \( -name '*.css' -o -name '*.js' \) -exec \
  sed -i -E 's@/\*[#@][[:space:]]*sourceMappingURL=[^*]+\*/@@g; s@//# sourceMappingURL=.*$@@g' {} +

# Generate versions file
COMMIT=$(git -c safe.directory="$PWD" rev-parse --short HEAD)
sed -e "s/VERSION/${VERSION}/g" -e "s/COMMIT/${COMMIT}/g" ./version.json.tmpl > "${DIST}/version.json"

# Canonical release archive
echo "Creating deterministic tar file ..."
find "${DIST}" -type d -exec chmod 0755 {} +
find "${DIST}" -type f -exec chmod 0644 {} +
find "${DIST}" -exec touch -d "@${SOURCE_DATE_EPOCH}" {} +
archive_tmp=$(mktemp "./dist/.${VERSION}.tar.gz.XXXXXX")
trap 'rm -f "$archive_tmp"' EXIT
tar --sort=name --format=gnu --mtime="@${SOURCE_DATE_EPOCH}" \
  --owner=0 --group=0 --numeric-owner -cf - -C "${DIST}" . | gzip -n > "$archive_tmp"
mv "$archive_tmp" "./dist/${VERSION}.tar.gz"
chmod 0644 "./dist/${VERSION}.tar.gz"
trap - EXIT

# Copy index.html for testing
sed -e "s/VERSION/${VERSION}/g" ./index.html.tmpl > ./dist/index.html

echo ""
echo "All done"
echo ""
